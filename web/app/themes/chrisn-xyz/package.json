{
  "name": "chrisn-xyz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "prebuild": "concurrently yarn:test yarn:typecheck yarn:lint",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "concurrently yarn:lint:* yarn:typecheck:*",
    "lint:eslint": "eslint --max-warnings 0",
    "lint:stylelint": "stylelint assets/**/*.scss"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.31",
    "postcss-preset-env": "^11.6.2",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-prettier": "^5.0.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-manifest-sri": "^0.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "ignoreDeprecations": "6.0"
          }
        }
      ]
    }
  },
  "stylelint": {
    "plugins": [
      "stylelint-selector-bem-pattern",
      "stylelint-prettier"
    ],
    "extends": [
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "selector-class-pattern": null,
      "prettier/prettier": true,
      "plugin/selector-bem-pattern": {
        "preset": "bem"
      }
    }
  },
  "prettier": {
    "trailingComma": "all",
    "printWidth": 120,
    "importOrder": [
      "^[.].*(?!css)$"
    ],
    "importOrderSeparation": true
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@fontsource/b612": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0"
  }
}
